# Public — safe to expose to the browser bundle. The browser always uses
# this one, regardless of POCKETBASE_INTERNAL_URL below.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Server-only, optional. If PocketBase and Next.js are co-located (same VPS,
# or sibling containers in docker-compose), point this at the private
# address/service name so server-side requests skip the public reverse
# proxy. Falls back to NEXT_PUBLIC_POCKETBASE_URL when unset.
# POCKETBASE_INTERNAL_URL=http://pocketbase:8090

# Server-only — never reference these from a "use client" file.
# Used exclusively for one-time tenant (shop) provisioning scripts, never
# for normal request handling (see lib/pocketbase-client.ts).
POCKETBASE_ADMIN_EMAIL=[REDACTED]
POCKETBASE_ADMIN_PASSWORD=[REDACTED]
